# Generate real local secrets with: python scripts/configure_local.py
TAVVO_ENV=development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
TAVVO_MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-Fernet-key
POSTGRES_PASSWORD=replace-local-owner-password
TAVVO_DB_PASSWORD=replace-local-runtime-password
DATABASE_URL=postgresql://tavvo_app:replace-local-runtime-password@127.0.0.1:55432/tavvo
MIGRATION_DATABASE_URL=postgresql://postgres:replace-local-owner-password@127.0.0.1:55432/tavvo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TAVVO_ADMIN_ORIGIN=http://localhost:5173
TAVVO_PUBLIC_ORIGIN=http://localhost:3000
IMAGE_STORAGE_BACKEND=s3
# For a private Vercel Blob store use vercel_blob and set BLOB_READ_WRITE_TOKEN server-side.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=tavvo-images
S3_REGION=us-east-1
S3_ACCESS_KEY=local-development
S3_SECRET_KEY=replace-local-storage-password
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Tavvo <no-reply@localhost>
